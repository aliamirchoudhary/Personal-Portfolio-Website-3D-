{
  "rewrites": [
    {
      "source": "/send-contact",
      "destination": "/api/send-contact"
    }
  ],
  "functions": {
    "api/send-contact.js": {
      "maxDuration": 30
    },
    "api/assistant.js": {
      "maxDuration": 20,
      "includeFiles": ".assistant-temp/knowledge.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'sha256-y5mS+j6dImfVYFLjhec19DUOkJnAep9HK4HJA/UfyrI=' 'sha256-pJRmZ9mxLO6Hv293DUIb+2k+Nj2PKq3BmVEi9oPpFaQ=' 'sha256-wZJ0ERnOdFOM9RTZZNfXYjhs0pTk6S1pIKW13P0ezTk=' 'sha256-n62pjIsUMIe38QdJZ9KxIOSZ+8E2RHmk5dGSNm7e7nE='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.web3forms.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
