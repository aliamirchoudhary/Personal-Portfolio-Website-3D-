# Optional free browser-side delivery. Obtain a key verified for your inbox at web3forms.com.
# This access key is designed to be public. Set in Vercel and redeploy to activate.
# When set, Web3Forms handles delivery/spam protection instead of Gmail SMTP/Redis.
VITE_WEB3FORMS_ACCESS_KEY=

# Gmail SMTP fallback (server only; never prefix secrets with VITE_)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
ADMIN_EMAIL=your-email@gmail.com

# Exact production origin. Preview deployment URL is allowed automatically.
FRONTEND_ORIGIN=https://ali-aamir-portfolio.vercel.app

# Required for production rate limiting and retry deduplication.
# Use a dedicated Redis database or namespace for this portfolio.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional portfolio assistant (free-only; local source answers work without these).
# Review docs/ASSISTANT_OPERATIONS.md before enabling. Never use VITE_ prefixes.
ASSISTANT_REMOTE_ENABLED=false
ASSISTANT_PROVIDER_REVIEWED=false
OPENROUTER_API_KEY=
OPENROUTER_FREE_MODEL=
OPENROUTER_FREE_MODELS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning:free
ASSISTANT_RATE_LIMIT_SECRET=

# Preferred AI Studio provider; keep the project on its unpaid tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_GEMINI_FREE_VERIFIED=false
# Owner-only localhost testing. Never enables the in-memory store in production.
ASSISTANT_LOCAL_TEST=false
ASSISTANT_GEMINI_LOCAL_TEST=false
# Public Gemini requires audience eligibility review and trusted Vercel geolocation.
# Unsupported/unknown countries use OpenRouter or local answers. Never add EEA/CH/GB.
ASSISTANT_GEMINI_PUBLIC_ELIGIBLE=false
ASSISTANT_GEMINI_COUNTRIES=PK
GEMINI_REQUESTS_PER_DAY=20
